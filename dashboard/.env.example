# Copy to .env.local. .env.local is gitignored by Next.js and must never be committed.

# The deployed CooperativeTreasury.
NEXT_PUBLIC_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# Optional. Falls back to the public Base Sepolia endpoint when unset.
# Use your own provider key here; this placeholder is not an authenticated URL.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
